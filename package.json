{
  "name": "hunch",
  "displayName": "Hunch",
  "description": "Experiment journal for ML: every run's code, config, metrics and why, as a tree in your editor. Local files, no account.",
  "version": "0.1.0",
  "publisher": "sigmoid-ide",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigmoid-ide/hunch-vscode"
  },
  "homepage": "https://github.com/sigmoid-ide/hunch",
  "bugs": "https://github.com/sigmoid-ide/hunch-vscode/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "experiment tracking",
    "machine learning",
    "deep learning",
    "mlops",
    "reproducibility"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:.hunch/runs"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Runs can be browsed, compared and annotated. Running Python (Run with Hunch, Save Milestone) needs a trusted workspace.",
      "restrictedConfigurations": [
        "hunch.interpreter"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hunch-sidebar",
          "title": "Hunch",
          "icon": "media/hunch-activity.svg"
        }
      ],
      "panel": [
        {
          "id": "hunch",
          "title": "Hunch",
          "icon": "media/hunch.svg"
        }
      ]
    },
    "views": {
      "hunch-sidebar": [
        {
          "id": "hunch.milestones",
          "name": "Milestones",
          "icon": "media/milestone.svg"
        }
      ],
      "hunch": [
        {
          "type": "webview",
          "id": "hunch.runs",
          "name": "Runs",
          "icon": "media/hunch.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hunch.milestones",
        "contents": "Your runs are in the Hunch tab of the panel.\n[Show Runs](command:hunch.showRuns)\nNo milestones yet. When you find something worth remembering, save one: Hunch sums up the runs since the last milestone and saves your code.\n[Save Milestone](command:hunch.saveMilestone)"
      }
    ],
    "commands": [
      {
        "command": "hunch.showRuns",
        "title": "Show Runs",
        "category": "Hunch",
        "icon": "$(list-tree)"
      },
      {
        "command": "hunch.refresh",
        "title": "Refresh",
        "category": "Hunch",
        "icon": "$(refresh)"
      },
      {
        "command": "hunch.compare",
        "title": "Compare",
        "category": "Hunch",
        "icon": "$(diff)"
      },
      {
        "command": "hunch.saveMilestone",
        "title": "Save Milestone...",
        "category": "Hunch",
        "icon": "$(milestone)"
      },
      {
        "command": "hunch.showQuickRuns",
        "title": "Show Quick Runs",
        "category": "Hunch",
        "icon": "$(filter)"
      },
      {
        "command": "hunch.hideQuickRuns",
        "title": "Hide Quick Runs",
        "category": "Hunch",
        "icon": "$(filter-filled)"
      },
      {
        "command": "hunch.filter",
        "title": "Filter Runs...",
        "icon": "$(filter)",
        "category": "Hunch"
      },
      {
        "command": "hunch.keep",
        "title": "Keep",
        "category": "Hunch"
      },
      {
        "command": "hunch.drop",
        "title": "Drop",
        "category": "Hunch"
      },
      {
        "command": "hunch.writeConclusion",
        "title": "Write Conclusion...",
        "category": "Hunch"
      },
      {
        "command": "hunch.editHypothesis",
        "title": "Edit Hypothesis...",
        "category": "Hunch"
      },
      {
        "command": "hunch.openRunFolder",
        "title": "Reveal Run Folder",
        "category": "Hunch"
      },
      {
        "command": "hunch.runFile",
        "title": "Run Python File with Hunch",
        "category": "Hunch",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hunch.showRuns",
          "when": "view == hunch.milestones",
          "group": "navigation@1"
        },
        {
          "command": "hunch.refresh",
          "when": "view == hunch.runs",
          "group": "navigation@1"
        },
        {
          "command": "hunch.compare",
          "when": "view == hunch.runs",
          "group": "navigation@2"
        },
        {
          "command": "hunch.saveMilestone",
          "when": "view == hunch.runs || view == hunch.milestones",
          "group": "navigation@3"
        },
        {
          "command": "hunch.filter",
          "when": "view == hunch.runs",
          "group": "navigation@4"
        }
      ],
      "webview/context": [
        {
          "command": "hunch.compare",
          "when": "webviewId == 'hunch.runs' && webviewSection == 'run'",
          "group": "1_compare@1"
        },
        {
          "command": "hunch.keep",
          "when": "webviewId == 'hunch.runs' && webviewSection == 'run'",
          "group": "2_verdict@1"
        },
        {
          "command": "hunch.drop",
          "when": "webviewId == 'hunch.runs' && webviewSection == 'run'",
          "group": "2_verdict@2"
        },
        {
          "command": "hunch.writeConclusion",
          "when": "webviewId == 'hunch.runs' && webviewSection == 'run'",
          "group": "2_verdict@3"
        },
        {
          "command": "hunch.editHypothesis",
          "when": "webviewId == 'hunch.runs' && webviewSection == 'run'",
          "group": "3_edit@1"
        },
        {
          "command": "hunch.openRunFolder",
          "when": "webviewId == 'hunch.runs' && webviewSection == 'run'",
          "group": "4_folder@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "hunch.runFile",
          "when": "resourceLangId == python && !isInDiffEditor",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "hunch.runFile",
          "when": "resourceLangId == python"
        },
        {
          "command": "hunch.showQuickRuns",
          "when": "!hunch.showingQuickRuns"
        },
        {
          "command": "hunch.hideQuickRuns",
          "when": "hunch.showingQuickRuns"
        }
      ]
    },
    "configuration": {
      "title": "Hunch",
      "properties": {
        "hunch.interpreter": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Python interpreter that has Hunch installed (`pip install sigmoid-hunch`). Leave empty to use the interpreter selected in the Python extension, then `python` on PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "vsce package --no-dependencies",
    "test:integration": "node esbuild.mjs && node test/integration/run.mjs"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
